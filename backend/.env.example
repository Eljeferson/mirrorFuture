# =================================================================
# MIRROR FUTURE - Environment Configuration Template
# =================================================================

# 1. AI ENGINE: META AI MODEL API (or Together AI / Groq / OpenAI-compatible endpoint)
META_LLAMA_API_KEY="your-meta-llama-api-key"
META_LLAMA_BASE_URL="https://api.meta.ai/v1"

# Official Meta Models (Muse Series & Llama)
LLAMA_VISION_MODEL="muse-spark-1.3"
LLAMA_FAST_MODEL="muse-spark-1.3-contributor"
LLAMA_REASONING_MODEL="muse-spark-1.3"
LLAMA_IMAGE_MODEL="muse-image-1.0"

# Optional alternative providers:
TOGETHER_API_KEY=""
GROQ_API_KEY=""

# 2. PRODUCTION DATABASE: SUPABASE + PGVECTOR
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# 3. WHATSAPP CLOUD API ACTUATOR (Optional for notifications)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# 4. ENVIRONMENT & RUNTIME
APP_ENV="development"
DEBUG="false"
TIMEOUT_SECONDS="60.0"
